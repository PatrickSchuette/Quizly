          "name": "Auth",
          "item": [
            {
              "name": "register_owner",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const NAME = pm.variables.replaceIn(\"{{$randomFirstName}} {{$randomLastName}}\");\nconst USERNAME = NAME.toLowerCase().replace(/ /g, '_') + \"_\" + Date.now();\nconst EMAIL = `${USERNAME}@test.de`;\npm.variables.set(\"USERNAME\", USERNAME);\npm.variables.set(\"EMAIL\", EMAIL);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));\nconst body = pm.response.json();\npm.test(\"Success message is returned\", () => pm.expect(body.detail).to.eql(\"User created successfully!\"));\nif (pm.response.code === 201) {\n    pm.environment.set(\"ownerUsername\", pm.variables.get(\"USERNAME\"));\n    pm.environment.set(\"ownerEmail\", pm.variables.get(\"EMAIL\"));\n}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"username\": \"{{USERNAME}}\",\n    \"email\": \"{{EMAIL}}\",\n    \"password\": \"{{password}}\",\n    \"confirmed_password\": \"{{password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/register/",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "register",
                    ""
                  ]
                }
              },
              "response": []
            },
