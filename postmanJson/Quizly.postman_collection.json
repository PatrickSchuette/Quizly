          "name": "Quizzes",
          "item": [
            {
              "name": "create_quiz",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));\nconst body = pm.response.json();\npm.test(\"Quiz has exactly 10 questions\", () => pm.expect(body.questions.length).to.eql(10));\npm.test(\"Every question has 4 options and a valid answer\", () => {\n    body.questions.forEach(q => {\n        pm.expect(q.question_options.length).to.eql(4);\n        pm.expect(q.question_options).to.include(q.answer);\n    });\n});\npm.test(\"video_url is saved in standard format\", () => pm.expect(body.video_url).to.match(/^https:\\/\\/www\\.youtube\\.com\\/watch\\?v=[A-Za-z0-9_-]{11}$/));\npm.test(\"Questions contain timestamps\", () => pm.expect(body.questions[0]).to.have.property(\"created_at\"));\nif (pm.response.code === 201) { pm.environment.set(\"quizId\", body.id); }"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"url\": \"{{youtube_url}}\"\n}",
